ENVIRONMENT=TEST

# Log Configurations
LOG_LEVEL=DEBUG
LOG_FORMAT=%(asctime)s - %(levelname)6s - %(name)15s - %(funcName)-35s:%(lineno)5d - %(message)s
LOG_FILE=./logs/tests.log
LOG_TO_CONSOLE=false

# Database Configurations
DATABASE_URL=sqlite:///./example/output/test_storage.db

# Data Ingestion Configurations
DATA_DIR=./example

# Agent Configurations
AGENT_MODEL=gemma4:e4b

# Match Configuration
MATCH_THRESHOLD=8
LLM_WEIGHT=0.7
TEXT_WEIGHT=0.3